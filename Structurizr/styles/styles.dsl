styles {
    element "Sistema Interno" {
        shape RoundedBox
        background #2d9bf0
        color White
        stroke #2d9bf0
    }

    element "Usuario Interno" {
        shape Person
        background #132f60
        color White
        stroke #132f60
    }

    element "Usuario Externo" {
        shape Person
        background #556266
        color White
        stroke #556266
    }

    element "API" {
        shape RoundedBox
        background #2d9bf0
        color White
        stroke #2d9bf0
    }

    element "Navegador Web" {
        shape WebBrowser
        background #2d9bf0
        color White
        stroke #2d9bf0
    }

    element "Almacenamiento" {
        shape Cylinder
        background #00810B
        color White
        stroke #00810B
    }
}
